{
  "name": "olympiad-coach",
  "version": "0.1.0",
  "private": true,
  "description": "A math olympiad coach that guides you to your own proof instead of giving away the solution.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "samples": "tsx scripts/make-samples.ts",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "handwriting-test": "tsx scripts/handwriting-test.ts"
  },
  "dependencies": {
    "@fontsource/comic-neue": "^5.3.0",
    "express": "^5.3.0",
    "immer": "^10.2.0",
    "katex": "^0.16.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
