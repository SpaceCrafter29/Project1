# Copy to .env and fill in. The key is only read by the server and never sent to the browser.

# auto = use the Meta API when MODEL_API_KEY is set, otherwise the built-in demo (mock) mode.
MODEL_PROVIDER=auto
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1

# Model IDs (placeholders until confirmed on dev.meta.ai).
# FAST handles transcription, hints, recognition, evaluation and chat.
MODEL_FAST=muse-spark-1.3
# STRONG is used for independent verification (refutations, solution checks, challenges).
MODEL_STRONG=muse-wonder-1.0
# Optional overrides: which model solves alternative approaches / verifies.
# MODEL_SOLVER=muse-spark-1.3
# MODEL_VERIFIER=muse-wonder-1.0

# Send response_format={"type":"json_object"}. Set to false if the API rejects it.
MODEL_JSON_MODE=true
MODEL_TIMEOUT_MS=120000

# Artificial delay for demo mode responses, in milliseconds.
MOCK_LATENCY_MS=500

PORT=8787
